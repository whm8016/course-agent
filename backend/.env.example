# ===========================================================================
# 配置示例（pydantic-settings 组合式嵌套）—— 复制为 .env 后按需修改
#
# env 用 <组>__<字段> 分隔式注入：
# LLM__API_KEY → settings.llm.api_key
# DB__URL → settings.db.url
# SECURITY__JWT_SECRET → settings.security.jwt_secret
#
# 例外（顶层扁平，env 名不变）：ENVIRONMENT / BACKEND_WORKERS /
# MAX_UPLOAD_MB / MAX_KB_UPLOAD_MB / LANGSMITH_*
# （langchain SDK 硬性读扁平 os.environ["LANGSMITH_API_KEY"]）
# ===========================================================================

# ===== 必填 =====
LLM__API_KEY=sk-your-key-here

# ===== 运行环境（生产务必修改）=====
# ENVIRONMENT=production
# SECURITY__JWT_SECRET=use-a-long-random-secret-at-least-32-chars
# SECURITY__ALLOWED_ORIGINS=https://your-frontend.example.com
# SECURITY__PROVIDER_ENCRYPTION_KEY= # 生产必填：加密用户级 LLM key（Fernet key）
# BACKEND_WORKERS=4

# ===== 数据库（PostgreSQL + Redis）=====
DB__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/course_agent
DB__REDIS_URL=redis://localhost:6379/0
# DB__POOL_SIZE=10
# DB__MAX_OVERFLOW=20

# ===== JWT 认证 =====
SECURITY__JWT_SECRET=change-me-in-production
# SECURITY__JWT_EXPIRE_HOURS=72

# ===== CORS（生产环境务必改为实际域名，多个用逗号分隔）=====
# 开发环境可用 *，生产请设为具体域名，例如：
# SECURITY__ALLOWED_ORIGINS=https://my-app.example.com,https://admin.example.com
SECURITY__ALLOWED_ORIGINS=*

# ===== LLM 模型（对话 + LightRAG 图谱 LLM；catalog 优先 → 此处兜底）=====
# 阿里云 DashScope（默认）：
# LLM__BINDING=dashscope
# LLM__TEXT_MODEL=qwen-plus
# LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek V4 Flash：
# LLM__BINDING=deepseek
# LLM__TEXT_MODEL=deepseek-v4-flash
# LLM__BASE_URL=https://api.deepseek.com
# DeepSeek V4 Pro（更强推理）：LLM__TEXT_MODEL=deepseek-v4-pro
# LLM__TIMEOUT_SEC=120
# LLM__CONTEXT_WINDOW=131072          # 模型标称上下文窗口（token）。显式配置优先于模型名模式与 heuristic 兜底；空=三级解析后两级

# ===== 嵌入 / 视觉（可与 LLM 分拆 provider；空凭证 → 回退 LLM__*）=====
# EMBEDDING__MODEL=text-embedding-v3
# EMBEDDING__API_KEY=sk-your-dashscope-key
# EMBEDDING__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 视觉模型（qwen-vl 系列，走独立 provider；主 LLM=deepseek 不支持看图）：
# 空 VISION__API_KEY → 回退 EMBEDDING__*（同属阿里 dashscope）
# VISION__MODEL = 对话时把用户发的图转描述（实时，要快 → flash）
# VISION__INDEX_MODEL = 索引知识库时提图（离线建库，可用更强模型；不配则同 MODEL）
# VISION__MODEL=qwen-vl-flash
# VISION__INDEX_MODEL=qwen-vl-plus
# VISION__API_KEY=sk-your-vision-key
# VISION__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Fallback LLM（主模型熔断时自动切换）=====
# FALLBACK__API_KEY=sk-your-fallback-key
# FALLBACK__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FALLBACK__MODEL=qwen-plus

# ===== RAG 切块调参 =====
# CHUNKING__SIZE=500
# CHUNKING__OVERLAP=80
# CHUNKING__TOP_K=4
# CHUNKING__INGEST_SIZE=1200  # 摄入切块大小（默认1200=现状；调小如600可能提升检索精度，需评测驱动）
# CHUNKING__INGEST_OVERLAP=120
# CHUNKING__STRATEGY=sentence_splitter  # 切块策略：sentence_splitter(默认,LlamaIndex按字数切,消融对照组) | ragflow_manual_docx(DOCX走RAGFlow Manual结构化切块:标题层级栈+表格原子化;非DOCX回退sentence_splitter)
# CHUNKING__SAVE_PG_INGEST_CHUNKS=true # llamaindex_pg 摄入切块是否落盘审计 JSON（data/ingest_chunks/course_{id}/latest.json，
#   含 chunks + node_ids=data_kb_chunks 主键）。仅排查/审计用，不参与检索；与 LIGHTRAG__SAVE_INGEST_CHUNKS 两后端各自独立。默认 true。

# ===== PDF 摄入解析（backend 二选一；切块统一 sentence_splitter，无降级链）=====
# PDF__BACKEND=mupdf  # mupdf(默认,轻量纯CPU无torch:get_toc章节+页码;无OCR/表格原子化) | docling(opt-in,单引擎全包:版面/表格/标题/页码+扫描件OCR;需 pip install docling rapidocr-onnxruntime[parse-docling extra],首次下模型到~/.cache/docling,未装则该文件报错跳过不降级)。选定失败则跳过该文件,不切另一个。
# PDF__DO_OCR=true  # 仅 docling：扫描件 OCR
# PDF__OCR_PROVIDER=rapid  # 仅 docling：rapid(RapidOCR,推荐,PaddleOCR模型ONNX版免装PaddlePaddle) | easyocr(Docling默认,需torch)

# ===== LightRAG（默认关闭；开启后可用 /api/chat/lightrag）=====
# 索引 LLM 专属 provider（完全独立，不受 model_catalog.json / 前端切换影响，无任何回退）。
# 未配 LIGHTRAG__LLM_MODEL / LIGHTRAG__API_KEY 时 is_lightrag_available 直接报错，
# 不会静默套用 llm.* 凭证——杜绝管理员切 provider 把 LightRAG 索引打挂。
# LIGHTRAG__LLM_MODEL=deepseek-v4-flash # 必填，base 模型（未配下面分角色时 extract/keyword/query 全用它）；无回退
# LIGHTRAG__API_KEY=sk-your-key # 必填，专属凭证（可与 LLM__API_KEY 不同）
# LIGHTRAG__BASE_URL=https://api.deepseek.com/v1
# 分角色模型（1.5.4+ role_llm_configs）：索引阶段 extract/keyword 走便宜档省成本。
# 须与 LIGHTRAG__LLM_MODEL 同 provider（如都在 deepseek）。不配则全回退 LLM_MODEL（行为不变）。
# LIGHTRAG__EXTRACT_MODEL=deepseek-v4-flash  # EXTRACT 实体/关系提取（索引 token 大头，用便宜档）
# LIGHTRAG__KEYWORD_MODEL=deepseek-v4-flash # KEYWORD 关键词提取
# 省钱组合：LLM_MODEL=deepseek-v4-pro（query 问答保质量）+ EXTRACT/KEYWORD=deepseek-v4-flash（索引省成本）
# LIGHTRAG__ENABLED=false
# LIGHTRAG__QUERY_MODE=mix # local | global | hybrid | naive | mix | bypass
# LIGHTRAG__TOP_K=6 # 种子实体/关系检索数量（同时也是 chunk_top_k 的上限）
# LIGHTRAG__TIMEOUT_SEC=120
# LIGHTRAG__EMBEDDING_DIM=1024
# LIGHTRAG__AUTO_INDEX_TTL_SEC=120 # 自动索引检查的最小间隔秒数，降低连续提问延迟
# LIGHTRAG__STREAM_CONTEXT_LIMIT=4 # 流式回答拼接的证据条数上限
# LIGHTRAG__STREAM_CONTEXT_MAX_CHARS=800 # 单条证据最大字符数，控制 prompt 体积
# LIGHTRAG__LRU_CAPACITY=6 # 每 worker 进程驻留的 LightRAG 实例上限（LRU 淘汰）。
#   PG 后端单实例仅数十 MB（图谱+asyncpg 句柄），per-worker 6 → 4 worker 峰值 ~1.2-1.9GB。
#   非 PG（默认内存后端）单实例数百 MB，按 BACKEND_WORKERS 整除（//workers，下限 2）防 OOM。
# LIGHTRAG__INSTANCE_IDLE_TTL_SEC=900 # 空闲实例超过此秒数未被引用 → 后台 reaper 回收（对标 pool_recycle）
# LIGHTRAG__INSTANCE_REAP_INTERVAL_SEC=60 # reaper 循环周期
# LIGHTRAG__SAVE_INGEST_CHUNKS=false # 摄入 chunk 原文是否落盘 JSON（仅审计，不参与检索，默认 true）。
#   40GB 云盘建议设 false 直接掐掉最大的纯浪费写入源；历史遗留由每日 GC（STORAGE_GC__*）清。
# LIGHTRAG__MIN_RERANK_SCORE=0.0 # 相关性阈值（RAG 第三道防线）：低于此分的 chunk 在 rerank 后丢弃。
#   仅在 enable_rerank=True 且 rerank_model_func 已挂载（需 EMBEDDING__API_KEY）时生效。
#   口径是 gte-rerank-v2 的 relevance_score（与裸余弦不同，勿照搬 0.5）。默认 0.0=不过滤=行为不变；
#   先用 scripts/eval_rag/ 问答集看分数分布，再定保守起点（预计 0.2-0.4）。

# ===== 图片知识图谱（教案 docx 内常有 400+ media，多为公式小图）=====
# IMAGE_INGEST__MIN_PX=80 # 宽高均 >= 此值才索引（默认 80）
# IMAGE_INGEST__MIN_AREA=15000 # 像素面积下限，约保留 60 张/教案（要更少可改 30000）
# IMAGE_INGEST__MAX_PER_FILE=120 # 单文件最多送 vision 的张数
# IMAGE_INGEST__SEMAPHORE=5 # VLM 并发上限（图片强制描述也复用此旋钮）

# ===== 图片强制 VLM 描述（解析层，默认关）=====
# 有图注的图片（如「图 1-1 股权架构图」）也调 VLM 把图里的结构/数字转成文本 inline 进 markdown，
# 使其可被向量检索召回（pgvector 无多模态 embedding，图必须转文本）。默认关=有图注则只留图注不调 VLM。
# 开启后每张图一次 VLM 调用（desc_cache 按图片字节 sha256 去重，重复索引不重花；并发度见 IMAGE_INGEST__SEMAPHORE）。
# PARSING__IMAGE_VLM_ALWAYS=true

# ===== 轮内上下文（Observation Masking 评测臂，dormant 主路径已走级联）=====
# CONTEXT_POLICY__ENABLED=true          # dormant：loop 轮内主路径已统一走 context_budget.enforce 三级级联，此开关仅供 apply 路径/评测臂回退
# CONTEXT_POLICY__KEEP_RECENT_TURNS=3   # 保留最近 N 轮 role=tool 原文，更早掩码（评测臂用）
# CONTEXT_POLICY__BUDGET_CHARS=80000    # dormant：掩码触发点已改 token 口径（compute_budgets soft_trigger），此值仅旧评测回退
# CONTEXT_POLICY__TOOL_RESULT_MAX_CHARS=6000  # 单条 tool 结果上限（0=不限）
# CONTEXT_POLICY__SUMMARY_ENABLED=false # hybrid 兜底摘要（多花一次 LLM 调用，默认关）

# ===== 通用上下文管理（双阈值 + 三级级联 + 反应式兜底）=====
# CONTEXT_BUDGET__TOKEN_ACCOUNTING_ENABLED=true   # system prompt 告警按 token 口径 + 逐切片分解（默认开）
# CONTEXT_BUDGET__CACHE_CONTROL_ENABLED=false     # Anthropic：T1 稳定前缀 + 末工具加 ephemeral 断点（命中≈0.1x；DeepSeek/Qwen 隐式缓存免费）
# CONTEXT_BUDGET__SYSTEM_PROMPT_WARN_TOKENS=2000  # system prompt token 告警阈值（≈旧 8000 字符口径）
# -- 双阈值（绝对 token，减法留白；软阈值=窗口比例线与绝对上限三取 min）--
# CONTEXT_BUDGET__ROT_THRESHOLD_TOKENS=128000     # 软阈值上限：比例线算出过大时钳制到此（rot 论文 64k 上界，1M 窗口放宽到 128k）
# CONTEXT_BUDGET__QUALITY_RATIO=0.5               # 软阈值比例线：effective_window × 此值（RULER 有效长度多为窗口 0.25-0.5，取 0.5 使 128k 模型算出 64000 与旧默认逐字相同）
# CONTEXT_BUDGET__OUTPUT_RESERVE_TOKENS=20000     # 输出预留上限：reserve = min(max_output, 此值)
# CONTEXT_BUDGET__SAFETY_MARGIN_TOKENS=4096       # 安全余量：tokenizer 差异/多模态/工具结果突增缓冲
# -- 三级级联（L1 清旧 tool 结果 -> L2 LLM 摘要 -> L3 丢最旧 20%）--
# CONTEXT_BUDGET__KEEP_RECENT_TURNS=3             # L1 保留最近 N 轮 tool 原文（对齐 Anthropic keep=3）
# CONTEXT_BUDGET__EXCLUDE_TOOLS=["ask_user"]      # L1 白名单：永不清理的 tool（不可重建输入）
# CONTEXT_BUDGET__MAX_CONSECUTIVE_FAILURES=3      # 反应式兜底连续失败熔断阈值（Claude Code MAX_CONSECUTIVE=3）
# -- 兼容（回合前 plan_turn 反应式裁剪 / eval 旧臂位）--
# CONTEXT_BUDGET__COORDINATOR_ENABLED=false       # 回合前 plan_turn 反应式裁剪开关（默认关=旧 resolve_budget 20% 裁历史）
# CONTEXT_BUDGET__CARRY_FORWARD_LOCATION=system_prompt  # history_prefix=超软阈值时摘要前插历史续接
# CONTEXT_BUDGET__EVICTION_STRATEGY=cascade       # dormant：新级联恒走 L1->L2->L3，不再按此分支

# ===== chat 知识库预检索（KB Seed，默认开）=====
# 进 agent loop 前用原问题预检索一次课程知识库，命中则注入首轮消息，材料够时第 1 轮直接作答。
# KB_SEED__ENABLED=true    # 默认开；关掉回退到「模型盲调多次 rag」的旧行为
# KB_SEED__MAX_CHARS=4000  # 单次预检索注入上限
# KB_SEED__TIMEOUT_S=8.0   # 超时降级为空串，绝不拖慢主链路

# ===== PG 检索精排（Rerank，默认关）=====
# 对 PG 检索（llamaindex_pg）RRF 融合结果做 Cross-Encoder 精排（DashScope qwen3-rerank），
# 凭证复用 EMBEDDING__API_KEY。默认关：需 run_eval --ablation 在本课程语料验证有正向收益后再开。
# 失败/超时一律降级回 RRF 排序，不拖垮主链路。
# RERANK__ENABLED=false        # 默认关；eval 验证后置 true 上线
# RERANK__MODEL=qwen3-rerank   # gte-rerank-v2 已于 2026-05-30 下线，迁移至此
# RERANK__CANDIDATE_TOP_N=20   # 送进精排的候选数（RRF 融合后取前 N）
# RERANK__MAX_REQUEST_TOKENS=100000  # 请求 token 上限，超则丢尾部候选避 400
# RERANK__TIMEOUT_S=5.0        # 查询热路径上外部 API 往返超时
# RERANK__MIN_SCORE=0.0        # 相关性阈值（精排后丢弃低于此分的候选；与 LIGHTRAG__MIN_RERANK_SCORE
#                              # 同口径=qwen3-rerank relevance_score，两后端可共用）。默认 0.0=不过滤。
#                              # 生效前置 RERANK__ENABLED=true；cross-encoder 分跨 query 不可比，须标定后开。

# ===== 文件上传 =====
# MAX_UPLOAD_MB=10
# MAX_KB_UPLOAD_MB=50

# ===== Web 搜索（默认 duckduckgo，免 key）=====
# duckduckgo：provider 直抓 html.duckduckgo.com（ddgs 8.1.1 库强制 bing backend、
# 国内不可用，故绕过库自抓）。国内裸直连搜索会被 202 限流，必须配 Clash 代理。
# ⚠️ 容器部署（docker compose）用 host.docker.internal:7897——容器内 127.0.0.1 是容器
# 自己，连不上宿主机 Clash（实测 ProxyError）。本地裸跑（非容器）才用 127.0.0.1:7897：
#SEARCH__PROVIDER=duckduckgo
#SEARCH__PROXY=http://host.docker.internal:7897
# 备用：tavily（国内可直连、无需代理，需 key）
#SEARCH__PROVIDER=tavily
#SEARCH__API_KEY=tvly-xxxxx

# ===== TutorBot 社交平台集成（默认关闭）=====
# TUTORBOT__ENABLED=false
# QQ Bot（需 pip install qq-botpy）：
# QQ_BOT__ENABLED=false
# QQ_BOT__APP_ID=
# QQ_BOT__SECRET=
# 飞书 Bot（需 pip install lark-oapi）：
# FEISHU__ENABLED=false
# FEISHU__APP_ID=
# FEISHU__APP_SECRET=

# ===== LangSmith / observability（顶层扁平，langchain SDK 读 os.environ）=====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxx
# LANGSMITH_PROJECT=mypj

# ===== mem0 记忆库遥测（建议禁用）=====
# mem0 内置 PostHog 遥测，启动连 us.i.posthog.com 拉 feature flag；国内被墙会刷 ERROR。
# MEM0_TELEMETRY=False # 设 False 直接不创建 client，消除噪音（mem0 库直接读此 env）

# ===== MCP 工具服务（部署级，配置文件 data/mcp.json）=====
# servers 字典，每个 server 含 type/command/url/headers/tool_timeout/enabled_tools/enabled。
# transport 自动检测：command→stdio、url 末尾 /sse→sse、其他 url→streamableHttp。
# 详见 core/mcp/config.py 的 MCPServerConfig。工具以 mcp_<server>_<tool> 形式
# 经 load_tools 渐进式揭示挂载到 agent loop。

# ===== LLM 用量统计（明细 + 日汇总两级存储）=====
# 每个 run_agent_loop 写一行 llm_usage_records 明细（带 mode/rounds，cost-of-pass 分析用）；
# 每小时 ARQ cron 重算今日+昨日聚合灌进 llm_usage_daily，admin/teacher 看板只读聚合表。
# 写库 best-effort（异常只记日志，绝不阻塞对话）。成本在摄取时按价目表快照落库（日后改价不篡改历史账）。
# USAGE_TRACKING__ENABLED=true               # 总开关。关=loop 不写明细、done 事件不带 usage
# USAGE_TRACKING__DETAIL_RETENTION_DAYS=90   # 明细保留天数（过期 cron 清；日汇总永久保留）
# USAGE_TRACKING__EXPOSE_COST_TO_STUDENT=false # 学生端气泡是否显示美元成本（token 数始终显示）

# ===== 磁盘派生数据 GC（offline cron，对标 Bazel 磁盘缓存 GC）=====
# 每日 04:17 ARQ cron + admin 端点（POST /api/admin/storage/gc?dry_run=true 默认只报不删）。
# 治理 parse_cache / lightrag_store(ingest_chunks+graphml) / pg ingest_chunks / uploads 只写不删的派生数据。
# kb_store/raw 只统计不清理（删掉无法重索引）。先跑 dry_run 看报告再放开。
# STORAGE_GC__ENABLED=true
# STORAGE_GC__PARSE_CACHE_MAX_GB=4.0      # 内容寻址解析缓存体积硬上限（按 mtime LRU 裁剪）
# STORAGE_GC__PARSE_CACHE_MAX_AGE_DAYS=30 # 解析缓存超过此天数按年龄清
# STORAGE_GC__LIGHTRAG_STORE_MAX_GB=2.0   # lightrag_store(graphml+ingest_chunks) 体积上限
# STORAGE_GC__INGEST_CHUNKS_MAX_AGE_DAYS=7 # ingest_chunks JSON 超此天数清（审计副本；lightrag/pg 两路共用此年龄口径）
# STORAGE_GC__PG_INGEST_CHUNKS_MAX_GB=1.0   # llamaindex_pg 审计 JSON（data/ingest_chunks 独立根）体积上限（按 mtime LRU 裁剪）
# STORAGE_GC__UPLOADS_MAX_GB=2.0           # 学生附件体积上限（裁剪孤儿）
# STORAGE_GC__UPLOADS_MAX_AGE_DAYS=0       # 0=关按年龄清（删旧附件会让历史会话图片失效）
# STORAGE_GC__ORPHAN_SWEEP_ENABLED=true   # 回收无 DB 归属的残留目录
# STORAGE_GC__DISK_WARN_PCT=75            # 整卷水位告警阈值（%）

# ===== 路径（一般不需要改）=====
# PATHS__UPLOAD_DIR=./uploads
# PATHS__KNOWLEDGE_DIR=./knowledge
# PATHS__DB_PATH=./data/sessions.db # 仅供 SQLite 迁移脚本读取旧数据
# PATHS__LIGHTRAG_WORKDIR=./lightrag_store
# PATHS__OUTPUT_CARDS_PATH=./data/output_cards.json # 对话后教学补充卡片存储
# PATHS__TUTORBOT_WORKSPACE_DIR=./data/tutorbot
# PATHS__INGEST_CHUNKS_DIR=./data/ingest_chunks # llamaindex_pg 摄入切块审计 JSON 独立根（与 parse_cache 同级；删整目录永远安全）
