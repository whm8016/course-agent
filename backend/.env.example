# ===== 必填 =====
DASHSCOPE_API_KEY=sk-your-key-here

# ===== 运行环境（生产务必修改）=====
# ENVIRONMENT=production
# JWT_SECRET=use-a-long-random-secret-at-least-32-chars
# ALLOWED_ORIGINS=https://your-frontend.example.com
# BACKEND_WORKERS=4
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# LLM_TIMEOUT_SEC=120

# ===== 数据库（PostgreSQL + Redis）=====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/course_agent
REDIS_URL=redis://localhost:6379/0

# ===== JWT 认证 =====
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72

# ===== CORS（生产环境务必改为实际域名，多个用逗号分隔）=====
# 开发环境可用 *，生产请设为具体域名，例如：
# ALLOWED_ORIGINS=https://my-app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# ===== LLM 模型（对话 + LightRAG 图谱 LLM）=====
# 阿里云 DashScope（默认）：
# TEXT_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek V4 Flash（当前默认）：
# DASHSCOPE_API_KEY=sk-your-deepseek-key
# TEXT_MODEL=deepseek-v4-flash
# DASHSCOPE_BASE_URL=https://api.deepseek.com
# DeepSeek V4 Pro（更强推理）：
# TEXT_MODEL=deepseek-v4-pro
# DASHSCOPE_BASE_URL=https://api.deepseek.com
# ===== 嵌入 / 视觉（可与 LLM 分拆 provider）=====
# EMBEDDING_API_KEY=sk-your-dashscope-key
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# VISION_MODEL=qwen-vl-plus

# ===== RAG 参数 =====
# RAG_BACKEND=fs              # fs | chroma（Windows 默认 fs）
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=4

# ===== LightRAG（默认关闭；开启后可用 /api/chat/lightrag）=====
# LIGHTRAG_ENABLED=false
# LIGHTRAG_WORKDIR=./lightrag_store
# LIGHTRAG_QUERY_MODE=mix         # local | global | hybrid | naive | mix | bypass
# LIGHTRAG_TOP_K=20
# LIGHTRAG_TIMEOUT_SEC=120
# LIGHTRAG_EMBEDDING_DIM=1024
# LIGHTRAG_AUTO_INDEX_TTL_SEC=120 # 自动索引检查的最小间隔秒数，降低连续提问延迟
# LIGHTRAG_STREAM_CONTEXT_LIMIT=4  # 流式回答拼接的证据条数上限
# LIGHTRAG_STREAM_CONTEXT_MAX_CHARS=800 # 单条证据最大字符数，控制 prompt 体积
# LIGHTRAG_LRU_CAPACITY=10         # 同时驻留内存的最大课程数（LRU 淘汰）；10门≈20GB，16GB服务器建议设4
# INGEST_CHUNK_SIZE=900
# INGEST_CHUNK_OVERLAP=60
# ===== LightRAG 分角色 LLM（1.5.4+，降低索引成本 70%）=====
# EXTRACT_MODEL=qwen-turbo  # 实体提取（索引时 token 大头，用便宜模型）
# KEYWORD_MODEL=qwen-turbo # 关键词提取（用最快最便宜模型）
# TEXT_MODEL 保持 qwen-plus 用于 QUERY（用户问答质量不变）

# ===== 图片知识图谱（教案 docx 内常有 400+ media，多为公式小图）=====
# IMAGE_INGEST_MIN_PX=80          # 宽高均 >= 此值才索引（默认 80）
# IMAGE_INGEST_MIN_AREA=15000     # 像素面积下限，约保留 60 张/教案（要更少可改 30000）
# IMAGE_INGEST_MAX_PER_FILE=120   # 单文件最多送 vision 的张数
# IMAGE_INGEST_SEMAPHORE=5

# ===== 文件上传 =====
# MAX_UPLOAD_MB=10

# ===== Web 搜索（可选，不配则用免费 DuckDuckGo）=====
# TAVILY_API_KEY=tvly-xxxxx

# ===== MCP 工具服务（部署级，配置文件 data/mcp.json）=====
# servers 字典，每个 server 含 type/command/url/headers/tool_timeout/enabled_tools/enabled。
# transport 自动检测：command→stdio、url 末尾 /sse→sse、其他 url→streamableHttp。
# 详见 core/mcp/config.py 的 MCPServerConfig。工具以 mcp_<server>_<tool> 形式
# 经 load_tools 渐进式揭示挂载到 agent loop（对标 DeepTutor）。

# ===== 补充卡片存储路径（对话后教学补充框，非 DeepTutor skill 知识包）=====
# OUTPUT_CARDS_STORE_PATH=./data/output_cards.json

# ===== 路径（一般不需要改）=====
# UPLOAD_DIR=./uploads
# KNOWLEDGE_DIR=./knowledge
# VECTORSTORE_DIR=./vectorstore
# DB_PATH=./data/sessions.db    # 仅供 SQLite 迁移脚本读取旧数据
