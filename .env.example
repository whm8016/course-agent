# ── 项目根目录 .env（docker-compose 自动加载）──────────────────────────────
# compose 文件里的 ${POSTGRES_PASSWORD} 等变量从这里读，不是 backend/.env！
# 部署：cp .env.example .env 后修改；backend/.env（应用层配置）另见
# backend/.env.example，两份都要配。
# ─────────────────────────────────────────────────────────────────────

# 【必填】postgres 数据库密码。默认 postgres 仅限开发兜底；
# ENVIRONMENT=production 时 settings 会因弱密码 fail-fast 拒绝启动。
# 注意：改密码需重建数据卷（docker compose down -v）才对新库生效。
POSTGRES_PASSWORD=postgres

# 运行环境：development | production。
# production 会强制校验：JWT_SECRET 非默认值 / CORS 非通配 / DB 密码非默认 /
# PROVIDER_ENCRYPTION_KEY 已设（详见 backend/settings/base.py _check_prod）。
ENVIRONMENT=development

# gunicorn worker 数（默认 4；4GB 部署机建议不超过 4）。
BACKEND_WORKERS=4

# LLM 调用超时（秒）。
LLM_TIMEOUT_SEC=120

# mcp-gateway：modelscope-mcp-server 的 API token（可空；空则该 server
# 工具调用时报鉴权错，不影响 gateway 本身与其余 server）。
MODELSCOPE_API_TOKEN=

# mcp-gateway 构建期 uv 镜像源（国内可设 https://pypi.tuna.tsinghua.edu.cn/simple）。
UV_INDEX_URL=
